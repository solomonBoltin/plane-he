# The upstream clone tools/apply.py works on. Never committed: it is 200+ MB of someone else's
# repository, and VERSION + the workflow's `git clone --branch` are the pin.
/upstream/
# Build output at the repo ROOT: the extracted SPA and the release tarball built from it.
# ANCHORED deliberately — a bare `web/` also matched `overrides/apps/web/`, which silently kept the
# app-shell override out of a commit while the tooling said everything was fine.
/web/
/*.tar.gz
